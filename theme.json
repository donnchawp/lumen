{
    "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
    "version": 3,
    "settings": {
        "appearanceTools": true,
        "useRootPaddingAwareAlignments": true,
        "color": {
            "custom": false,
            "customDuotone": false,
            "defaultPalette": false,
            "defaultGradients": false,
            "palette": [
                {
                    "slug": "bg-primary",
                    "name": "Background",
                    "color": "#0a0a0a"
                },
                {
                    "slug": "bg-secondary",
                    "name": "Background, raised",
                    "color": "#111111"
                },
                {
                    "slug": "bg-tertiary",
                    "name": "Background, panel",
                    "color": "#1a1a1a"
                },
                {
                    "slug": "border",
                    "name": "Border",
                    "color": "#1a1a1a"
                },
                {
                    "slug": "border-hover",
                    "name": "Border, hover",
                    "color": "#333333"
                },
                {
                    "slug": "text-primary",
                    "name": "Text",
                    "color": "#e5e5e5"
                },
                {
                    "slug": "text-secondary",
                    "name": "Text, secondary",
                    "color": "#888888"
                },
                {
                    "slug": "text-muted",
                    "name": "Text, muted",
                    "color": "#7c7c7c"
                },
                {
                    "slug": "accent",
                    "name": "Accent",
                    "color": "#ffffff"
                },
                {
                    "slug": "accent-overlay",
                    "name": "Accent, on photo",
                    "color": "#ffffff"
                },
                {
                    "slug": "text-overlay",
                    "name": "Text, on photo",
                    "color": "#888888"
                }
            ]
        },
        "spacing": {
            "units": [
                "px",
                "rem",
                "vh",
                "vw"
            ]
        },
        "layout": {
            "contentSize": "700px",
            "wideSize": "1400px"
        },
        "typography": {
            "customFontSize": false,
            "fluid": false
        }
    },
    "styles": {
        "color": {
            "background": "var(--bg-primary)",
            "text": "var(--text-primary)"
        },
        "elements": {
            "button": {
                "border": {
                    "color": "var(--border-hover)",
                    "radius": "4px",
                    "style": "solid",
                    "width": "1px"
                },
                "color": {
                    "background": "var(--bg-tertiary)",
                    "text": "var(--text-primary)"
                },
                "spacing": {
                    "padding": {
                        "top": "0.7rem",
                        "right": "1.2rem",
                        "bottom": "0.7rem",
                        "left": "1.2rem"
                    }
                },
                "typography": {
                    "fontFamily": "inherit",
                    "fontSize": "0.9rem"
                },
                ":hover": {
                    "border": {
                        "color": "var(--accent)"
                    },
                    "color": {
                        "text": "var(--accent)"
                    }
                }
            },
            "link": {
                "color": {
                    "text": "var(--accent)"
                }
            }
        },
        "blocks": {
            "core/comment-date": {
                "color": {
                    "text": "var(--text-muted)"
                },
                "elements": {
                    "link": {
                        "color": {
                            "text": "var(--text-muted)"
                        }
                    }
                },
                "typography": {
                    "fontSize": "0.8rem"
                }
            },
            "core/comments-pagination": {
                "elements": {
                    "link": {
                        "color": {
                            "text": "var(--text-secondary)"
                        },
                        ":hover": {
                            "color": {
                                "text": "var(--accent)"
                            }
                        }
                    }
                },
                "spacing": {
                    "margin": {
                        "bottom": "2rem"
                    }
                },
                "typography": {
                    "fontSize": "0.85rem"
                }
            },
            "core/comments-title": {
                "color": {
                    "text": "var(--text-muted)"
                },
                "spacing": {
                    "margin": {
                        "bottom": "2rem"
                    }
                },
                "typography": {
                    "fontSize": "0.85rem",
                    "fontWeight": "400",
                    "letterSpacing": "0.15em",
                    "textTransform": "uppercase"
                }
            },
            "core/navigation": {
                "color": {
                    "text": "var(--text-secondary)"
                },
                "typography": {
                    "fontSize": "0.85rem",
                    "letterSpacing": "0.05em",
                    "textTransform": "uppercase"
                }
            },
            "core/post-navigation-link": {
                "elements": {
                    "link": {
                        "color": {
                            "text": "var(--text-primary)"
                        },
                        "typography": {
                            "fontSize": "0.95rem"
                        },
                        ":hover": {
                            "color": {
                                "text": "var(--accent)"
                            }
                        }
                    }
                }
            },
            "core/post-title": {
                "spacing": {
                    "margin": {
                        "bottom": "0.5rem"
                    }
                },
                "typography": {
                    "fontSize": "2rem",
                    "fontWeight": "300",
                    "letterSpacing": "0.02em"
                }
            },
            "core/query-title": {
                "color": {
                    "text": "var(--text-muted)"
                },
                "typography": {
                    "fontSize": "1.2rem",
                    "fontWeight": "400",
                    "letterSpacing": "0.15em",
                    "textTransform": "uppercase"
                }
            },
            "core/site-tagline": {
                "color": {
                    "text": "var(--text-secondary)"
                },
                "spacing": {
                    "margin": {
                        "top": "0.5rem"
                    }
                },
                "typography": {
                    "fontSize": "0.9rem",
                    "letterSpacing": "0.1em"
                }
            },
            "core/site-title": {
                "color": {
                    "text": "var(--accent)"
                },
                "elements": {
                    "link": {
                        "color": {
                            "text": "var(--accent)"
                        }
                    }
                },
                "typography": {
                    "fontSize": "2.5rem",
                    "fontWeight": "200",
                    "letterSpacing": "0.15em",
                    "textTransform": "uppercase"
                }
            },
            "core/term-description": {
                "color": {
                    "text": "var(--text-secondary)"
                },
                "spacing": {
                    "margin": {
                        "top": "0.75rem"
                    }
                },
                "typography": {
                    "fontSize": "0.9rem"
                }
            }
        },
        "css": ":root{--bg-primary:var(--wp--preset--color--bg-primary);--bg-secondary:var(--wp--preset--color--bg-secondary);--bg-tertiary:var(--wp--preset--color--bg-tertiary);--border:var(--wp--preset--color--border);--border-hover:var(--wp--preset--color--border-hover);--text-primary:var(--wp--preset--color--text-primary);--text-secondary:var(--wp--preset--color--text-secondary);--text-muted:var(--wp--preset--color--text-muted);--accent:var(--wp--preset--color--accent);--accent-overlay:var(--wp--preset--color--accent-overlay);--text-overlay:var(--wp--preset--color--text-overlay);}"
    },
    "templateParts": [
        {
            "name": "header",
            "title": "Header",
            "area": "header"
        },
        {
            "name": "header-home",
            "title": "Header (home)",
            "area": "header"
        },
        {
            "name": "footer",
            "title": "Footer",
            "area": "footer"
        }
    ]
}
