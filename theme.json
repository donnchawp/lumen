{
    "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
    "version": 3,
    "settings": {
        "appearanceTools": true,
        "useRootPaddingAwareAlignments": true,
        "color": {
            "custom": false,
            "customDuotone": false,
            "defaultPalette": false,
            "defaultGradients": false
        },
        "spacing": {
            "units": [
                "px",
                "rem",
                "vh",
                "vw"
            ]
        },
        "layout": {
            "contentSize": "700px",
            "wideSize": "1400px"
        },
        "typography": {
            "customFontSize": false,
            "fluid": true
        }
    },
    "styles": {
        "color": {
            "background": "var(--bg-primary)",
            "text": "var(--text-primary)"
        },
        "elements": {
            "link": {
                "color": {
                    "text": "var(--accent)"
                }
            }
        },
        "css": ":root{--bg-primary:#0a0a0a;--bg-secondary:#111111;--bg-tertiary:#1a1a1a;--border:#1a1a1a;--border-hover:#333333;--text-primary:#e5e5e5;--text-secondary:#888888;--text-muted:#7c7c7c;--accent:#ffffff;--accent-overlay:#ffffff;--text-overlay:#888888;}"
    },
    "templateParts": [
        {
            "name": "header",
            "title": "Header",
            "area": "header"
        },
        {
            "name": "header-home",
            "title": "Header (home)",
            "area": "header"
        },
        {
            "name": "footer",
            "title": "Footer",
            "area": "footer"
        }
    ]
}
